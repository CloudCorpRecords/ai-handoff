{
  "schemaVersion": 1,
  "name": "ai-handoff",
  "displayName": "AI Handoff",
  "version": "0.1.0",
  "description": "Lets two AI coding tools hand work to each other through one shared per-repo handoff file, so the human does not have to translate.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "ai-handoff",
        "path": "skills/ai-handoff/SKILL.md",
        "enabledDefault": true
      }
    ],
    "commands": [
      {
        "id": "handoff-read",
        "path": "commands/handoff-read.md",
        "enabledDefault": true
      },
      {
        "id": "handoff-write",
        "path": "commands/handoff-write.md",
        "enabledDefault": true
      },
      {
        "id": "handoff-ask",
        "path": "commands/handoff-ask.md",
        "enabledDefault": true
      }
    ],
    "hooks": [
      {
        "id": "handoff-sync",
        "event": "PreToolUse",
        "command": ["python3", "hooks/handoff-hook.py"],
        "timeoutMs": 5000,
        "statusMessage": "Checking the AI handoff file"
      }
    ],
    "mcpServers": [
      {
        "id": "ai-handoff",
        "transport": "stdio",
        "command": ["python3", "mcp/server.py"]
      }
    ],
    "reminders": []
  }
}
